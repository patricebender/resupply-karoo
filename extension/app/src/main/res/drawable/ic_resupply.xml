    <group>
        <clip-path android:pathData="M116,0 L396,0 A116,116 0 0 1 512,116 L512,396 A116,116 0 0 1 396,512 L116,512 A116,116 0 0 1 0,396 L0,116 A116,116 0 0 1 116,0 Z" />
