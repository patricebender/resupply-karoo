<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Detect WiFi vs phone-tethered so the picker can advise on download speed. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Region downloads run in a foreground service holding a wake lock, so a large
         download survives the picker closing / the Karoo's aggressive screen sleep. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Drive the OS installer from Settings to update the sideloaded app in place. Gated
         per-app by the "install unknown apps" toggle; the UI sends the rider there first
         when canRequestPackageInstalls() is false. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:name=".ResupplyApplication"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:theme="@style/Theme.Resupply">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <service
            android:name=".extension.ResupplyExtension"
            android:exported="true"
            tools:ignore="ExportedService">
            <!-- Discovered by the Karoo System as an extension. -->
            <intent-filter>
                <action android:name="io.hammerhead.karooext.KAROO_EXTENSION" />
            </intent-filter>
            <meta-data
                android:name="io.hammerhead.karooext.EXTENSION_INFO"
                android:resource="@xml/extension_info" />
        </service>

        <!-- Downloads a region file over WiFi (streamed, uncapped) in the foreground so it
             survives the app backgrounding and the screen sleeping. -->
        <service
            android:name=".service.RegionDownloadService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Downloads the latest release APK over WiFi and hands it to the OS installer,
             so the rider can update the sideloaded app from Settings. -->
        <service
            android:name=".service.AppUpdateService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Receives the PackageInstaller commit result: launches the system confirm-install
             dialog on STATUS_PENDING_USER_ACTION. -->
        <receiver
            android:name=".service.AppUpdateService$InstallReceiver"
            android:exported="false" />

        <!-- Karoo Extensions library: where the on-device store fetches version/update
             info. $BASE_URL$ is substituted at build time by the generateManifest Gradle
             task (CI only); locally it stays literal and is harmless for sideloading. -->
        <meta-data
            android:name="io.hammerhead.karooext.MANIFEST_URL"
            android:value="$BASE_URL$/manifest.json" />

    </application>

</manifest>
