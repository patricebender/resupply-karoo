<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".ResupplyApplication"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:theme="@style/Theme.Resupply">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <service
            android:name=".extension.ResupplyExtension"
            android:exported="true"
            tools:ignore="ExportedService">
            <!-- Discovered by the Karoo System as an extension. -->
            <intent-filter>
                <action android:name="io.hammerhead.karooext.KAROO_EXTENSION" />
            </intent-filter>
            <meta-data
                android:name="io.hammerhead.karooext.EXTENSION_INFO"
                android:resource="@xml/extension_info" />
        </service>

        <!-- Karoo Extensions library: where the on-device store fetches version/update
             info. $BASE_URL$ is substituted at build time by the generateManifest Gradle
             task (CI only); locally it stays literal and is harmless for sideloading. -->
        <meta-data
            android:name="io.hammerhead.karooext.MANIFEST_URL"
            android:value="$BASE_URL$/manifest.json" />

    </application>

</manifest>
